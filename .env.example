# LiveStream Hub environment variables
# Copy to .env and edit before running

# REQUIRED: Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret

# Admin account (created on first boot if no user exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Timezone
TZ=UTC

# Auto-restart streams after VPS reboot
AUTO_RESUME_ON_BOOT=true

# Database (sqlite default; mysql optional - see docs)
DB_TYPE=sqlite
